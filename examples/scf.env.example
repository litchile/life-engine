# Copy these into SCF environment variables. Keep real values out of Git.

# Ingress function
COS_BUCKET=your-private-bucket
COS_REGION=ap-guangzhou
FEISHU_VERIFICATION_TOKEN=

# Processor function
FEISHU_APP_ID=
FEISHU_APP_SECRET=
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.example.com
AI_MODEL=your-text-model
AI_API_KEY=
AI_TIMEOUT_MS=25000
AI_THINKING_MODE=disabled
BOT_TIMEZONE=Asia/Tokyo

# Optional Feishu targeting. Prefer chat/user ids from your own tenant.
FEISHU_DIARY_RECEIVE_ID=
FEISHU_OWNER_OPEN_ID=
FEISHU_BOT_OPEN_ID=

# Example character binding is produced by:
# node scripts/character-pack.mjs prepare examples/harbor-fox.json examples/instance.example.json activation-plan.json
LIFE_ENGINE_PACK_KEY=
LIFE_ENGINE_PACK_SHA256=
LIFE_ENGINE_CONFIG_JSON=

# Start in text mode. The example pack has no images.
IMAGE_MODE=disabled
IMAGE_PROVIDER=
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_API_KEY=
DASHSCOPE_API_KEY=
ALIYUN_BAILIAN_WORKSPACE_ID=
IMAGE_TIMEOUT_MS=120000

VISION_MODE=disabled
VISION_PROVIDER=openai-compatible
VISION_BASE_URL=
VISION_MODEL=
VISION_API_KEY=
VISION_TIMEOUT_MS=30000

LINK_READER_MODE=enabled
LINK_TIMEOUT_MS=10000
